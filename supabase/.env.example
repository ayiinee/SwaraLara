# Supabase CLI/runtime supplies SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. Do not override reserved SUPABASE_* names here.
# Physical ADB device: run `adb reverse tcp:54321 tcp:54321` on the host.
# Use the same public origin in android/local.properties (debug builds only).
SWL_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
