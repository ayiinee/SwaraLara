# Public configuration template; contains no credentials.
# Android reads android/local.properties, not this file automatically.
# Copy these two public values into android/local.properties.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Edge API public origin. Copy this setting into supabase/.env when using
# `supabase functions serve api --env-file supabase/.env`.
# Supabase CLI supplies its reserved SUPABASE_* server variables itself.
SWL_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# For a physical Android device with Supabase running on this PC:
# adb reverse tcp:54321 tcp:54321
# Use http://127.0.0.1:54321 for both URL settings (debug builds only).
# Never put a service-role key, private key, or real password in the Android app.
